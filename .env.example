# Copy this file to `.env` and tweak as needed before running docker-compose.

# JWT signing secret. CHANGE THIS for anything beyond local experimentation.
JWT_SECRET=change-me-in-production

# Postgres credentials are wired through docker-compose.yml directly.
# These are only relevant when running the backend outside the compose stack.
DATABASE_URL=postgresql+asyncpg://messenger:messenger@localhost:5432/messenger
SYNC_DATABASE_URL=postgresql+psycopg2://messenger:messenger@localhost:5432/messenger
DEBUG=false
